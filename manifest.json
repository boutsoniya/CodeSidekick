{
  "manifest_version": 3,
  "name": "CodeSidekick",
  "version": "0.1.1",
  "description": "AI coding practice companion for explanations, hints, debugging, and interview preparation.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://localhost:8000/*", "https://*/*"],
  "action": {
    "default_title": "Open CodeSidekick"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}